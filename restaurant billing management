import tkinter as tk
from tkinter import messagebox
from openpyxl import Workbook, load_workbook
import os

# Excel file name
FILE_NAME = "restaurant_data.xlsx"


# Excel file तयार करणे
def create_excel():

    if not os.path.exists(FILE_NAME):

        workbook = Workbook()
        sheet = workbook.active

        sheet.append([
            "Customer Name",
            "Food Name",
            "Quantity",
            "Price",
            "Total"
        ])

        workbook.save(FILE_NAME)


# Save Data function
def save_data():

    # Get data from boxes
    customer = name_entry.get()
    food = food_entry.get()
    quantity = quantity_entry.get()
    price = price_entry.get()

    # Check empty data
    if customer == "" or food == "" or quantity == "" or price == "":
        messagebox.showwarning(
            "Warning",
            "Please enter all data"
        )
        return

    # Convert quantity and price into number
    quantity = int(quantity)
    price = int(price)

    # Calculate total
    total = quantity * price

    # Open Excel file
    workbook = load_workbook(FILE_NAME)
    sheet = workbook.active

    # Add data to Excel
    sheet.append([
        customer,
        food,
        quantity,
        price,
        total
    ])

    # Save Excel file
    workbook.save(FILE_NAME)

    # Show message
    messagebox.showinfo(
        "Success",
        "Data saved successfully in Excel!"
    )

    # Clear boxes
    name_entry.delete(0, tk.END)
    food_entry.delete(0, tk.END)
    quantity_entry.delete(0, tk.END)
    price_entry.delete(0, tk.END)


# Create Excel file
create_excel()


# Main window
window = tk.Tk()

window.title("Restaurant Management System")
window.geometry("500x500")


# Heading
title = tk.Label(
    window,
    text="Restaurant Management System",
    font=("Arial", 20, "bold")
)

title.pack(pady=20)


# Customer Name
tk.Label(
    window,
    text="Customer Name"
).pack()

name_entry = tk.Entry(
    window,
    width=30
)

name_entry.pack(pady=5)


# Food Name
tk.Label(
    window,
    text="Food Name"
).pack()

food_entry = tk.Entry(
    window,
    width=30
)

food_entry.pack(pady=5)


# Quantity
tk.Label(
    window,
    text="Quantity"
).pack()

quantity_entry = tk.Entry(
    window,
    width=30
)

quantity_entry.pack(pady=5)


# Price
tk.Label(
    window,
    text="Price"
).pack()

price_entry = tk.Entry(
    window,
    width=30
)

price_entry.pack(pady=5)


# Save Button
save_button = tk.Button(
    window,
    text="Save Data",
    command=save_data,
    width=20
)

save_button.pack(pady=20)


# Exit Button
exit_button = tk.Button(
    window,
    text="Exit",
    command=window.destroy,
    width=20
)

exit_button.pack()


# Start program
window.mainloop()
